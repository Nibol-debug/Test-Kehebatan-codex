{
  "name": "syiar-gemilang-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles.css -o ./src/public/css/main.css --minify",
    "dev:css": "tailwindcss -i ./src/styles.css -o ./src/public/css/main.css --watch",
    "start": "node server.js",
    "dev": "concurrently \"nodemon server.js\" \"npm run dev:css\"",
    "test": "node --test"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "method-override": "^3.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.3",
    "supertest": "^7.1.0",
    "tailwindcss": "^3.4.17"
  }
}
